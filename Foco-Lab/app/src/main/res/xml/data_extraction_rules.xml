<?xml version="1.0" encoding="utf-8"?>
<!-- Auditoría: desde Android 12, allowBackup="false" no detiene la transferencia entre dispositivos (Smart Switch).
     Se excluye todo: plan, bloqueos, candado del modo estricto y registro se quedan en este teléfono. -->
<data-extraction-rules>
 <cloud-backup>
  <exclude domain="root"/><exclude domain="file"/><exclude domain="database"/><exclude domain="sharedpref"/><exclude domain="external"/>
 </cloud-backup>
 <device-transfer>
  <exclude domain="root"/><exclude domain="file"/><exclude domain="database"/><exclude domain="sharedpref"/><exclude domain="external"/>
 </device-transfer>
</data-extraction-rules>
