+// ---------- Result: attention map by quadrant ----------
+
+@Composable internal fun OrbitAttention(r: ResultRow) {
+ val logs = remember(r.id) { boardLogs(r) }
+ val parsed = remember(r.id) { logs.mapNotNull(OrbitLog::decode) }
+ if (parsed.isEmpty()) return
+ val quadrants = remember(r.id) { Orbit.attention(logs) }
+ val colors = MaterialTheme.colorScheme; val measurer = rememberTextMeasurer()
+ val es = Locale("es")
+ fun seconds(ms: Long) = String.format(es, "%.2f s", ms / 1000.0)
+ val heat = quadrants.map { q -> if (q.touches == 0 && q.misses == 0) null else (q.meanMs ?: 1500L) / 1000f + q.misses * .6f }
+ val lo = heat.filterNotNull().minOrNull() ?: 0f; val hi = heat.filterNotNull().maxOrNull() ?: 0f
+ Panel {
+  Label("Mapa de atención espacial", colors.primary)
+  Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+   listOf("${parsed.sumOf { it.points }}" to "puntos", "${parsed.count { it.focus }}" to "bonos de enfoque", OrbitMode.of(parsed.first().mode).title to "modo").forEach { (v, l) ->
+    Column(Modifier.weight(1f)) { Text(v, style = MaterialTheme.typography.titleMedium); Text(l, style = MaterialTheme.typography.labelSmall, color = colors.onSurfaceVariant) }
+   }
+  }
+  val ink = colors.onSurface; val mute = colors.onSurfaceVariant; val empty = colors.surfaceVariant; val missColor = colors.error
+  Canvas(Modifier.fillMaxWidth().height(230.dp).semantics { contentDescription = "Mapa de la órbita por cuadrantes con tiempo medio y fallos" }) {
+   val s = size.minDimension; val rr = s * .36f; val wdt = s * .09f
+   drawCircle(empty, rr, center, style = Stroke(1.dp.toPx()))
+   quadrants.forEachIndexed { i, q ->
+    val v = heat[i]
+    val color = if (v == null) empty else { val x = if (hi > lo) (v - lo) / (hi - lo) else 0f; if (x < .5f) lerp(OrbitCyan, OrbitAmber, x * 2) else lerp(OrbitAmber, OrbitCoral, (x - .5f) * 2) }
+    drawArc(color, -90f + i * 90f + 4f, 82f, false, Offset(center.x - rr, center.y - rr), Size(rr * 2, rr * 2), style = Stroke(wdt, cap = StrokeCap.Round))
+    val am = Math.toRadians(-90.0 + i * 90 + 45).toFloat(); val at = Offset(center.x + cos(am) * rr * .55f, center.y + sin(am) * rr * .55f)
+    val top = measurer.measure(q.meanMs?.let(::seconds) ?: "—", TextStyle(color = ink, fontSize = (s * .05f).toSp(), fontWeight = FontWeight.Bold))
+    drawText(top, topLeft = Offset(at.x - top.size.width / 2f, at.y - top.size.height))
+    val bottom = measurer.measure(if (q.misses == 1) "1 fallo" else "${q.misses} fallos", TextStyle(color = if (q.misses > 0) missColor else mute, fontSize = (s * .04f).toSp()))
+    drawText(bottom, topLeft = Offset(at.x - bottom.size.width / 2f, at.y + 2f))
+   }
+  }
+  Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp, Alignment.CenterHorizontally)) {
+   Text("Rápido y preciso", style = MaterialTheme.typography.labelSmall, color = colors.onSurfaceVariant)
+   Box(Modifier.width(80.dp).height(6.dp).clip(RoundedCornerShape(3.dp)).background(Brush.horizontalGradient(listOf(OrbitCyan, OrbitAmber, OrbitCoral))))
+   Text("Lento o con fallos", style = MaterialTheme.typography.labelSmall, color = colors.onSurfaceVariant)
+  }
+  val timed = quadrants.withIndex().filter { it.value.meanMs != null }
+  if (timed.size >= 2) {
+   val slow = timed.maxBy { it.value.meanMs!! }; val fast = timed.minBy { it.value.meanMs!! }
+   Text("Reaccionas más despacio en el cuadrante ${Orbit.quadrantNames[slow.index]} (${seconds(slow.value.meanMs!!)} de media) y más rápido en el ${Orbit.quadrantNames[fast.index]} (${seconds(fast.value.meanMs!!)}).", style = MaterialTheme.typography.bodyMedium)
+  }
+  val worst = quadrants.withIndex().filter { it.value.misses > 0 }.maxByOrNull { it.value.misses }
+  Text(if (worst != null) "La mayoría de tus fallos están en el cuadrante ${Orbit.quadrantNames[worst.index]}. En la próxima sesión, fija la mirada en el núcleo y sigue esa zona con la visión periférica."
+   else "Ningún fallo por cuadrante: tu atención se reparte bien por toda la órbita.", style = MaterialTheme.typography.bodyMedium, color = colors.onSurfaceVariant)
+ }
+}
