+// ---------- Unified progress bar (rounds, points and the record ghost in one place) ----------
+
+/** Running points of the best earlier partida in the same mode, round by round; null when there is none yet. */
+@Composable internal fun rememberOrbitGhost(vm: BrainViewModel, run: Run): List<Int>? = remember(run.id, run.variant) {
+ val mode = OrbitMode.of(run.variant)
+ vm.results.value.asSequence().filter { it.game == Orbit.ID && it.id != run.id }.map(::boardLogs)
+  .filter { logs -> logs.any { OrbitLog.decode(it) != null } && Orbit.modeOf(logs) == mode }
+  .map(Orbit::cumulative).maxByOrNull { it.lastOrNull() ?: 0 }?.takeIf { (it.lastOrNull() ?: 0) > 0 }
+}
+
+/** One segmented bar of 12 blocks (emerald right, coral wrong), the points line and the gold ghost tick inside it. */
+@Composable internal fun OrbitHeader(run: Run, logs: List<String>, ghost: List<Int>?, endlessRound: Int?) {
+ val motion = LocalMotionEnabled.current; val colors = MaterialTheme.colorScheme
+ val points = Orbit.cumulative(logs).lastOrNull() ?: 0
+ val played = logs.size
+ val ghostNow = ghost?.let { if (played == 0) 0 else it[min(played, it.size) - 1] }
+ val pulse = if (motion) rememberInfiniteTransition(label = "Ronda actual").animateFloat(1f, .45f, infiniteRepeatable(tween(800), RepeatMode.Reverse), label = "Pulso").value else 1f
+ val current = areaColor(Area.MEMORY)
+ Column(Modifier.fillMaxWidth(), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+  Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+   Label((if (endlessRound != null) "Ronda ${endlessRound + 1}" else "Ronda ${run.index + 1} / ${Orbit.ROUNDS}") + " · $points pts")
+   Spacer(Modifier.weight(1f))
+   if (ghost != null && ghostNow != null) {
+    val diff = points - ghostNow
+    Text(when { played == 0 -> "Fantasma · récord ${ghost.last()}"; diff > 0 -> "Fantasma: +$diff"; diff == 0 -> "Fantasma: empatado"; else -> "Fantasma: −${-diff}" },
+     style = MaterialTheme.typography.labelMedium, color = if (played > 0 && diff > 0) OrbitEmerald else ChestGold)
+   }
+  }
+  Row(Modifier.fillMaxWidth().height(8.dp).semantics { contentDescription = "Ronda ${run.index + 1} de ${Orbit.ROUNDS}: ${run.outcomes.count { it.correct }} aciertos" }, horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+   for (i in 0 until Orbit.ROUNDS) {
+    val o = run.outcomes.getOrNull(i)
+    val fill = when {
+     o == null -> if (i == run.index) current.copy(alpha = pulse) else colors.surfaceVariant
+     o.reason == "survival" -> colors.surfaceVariant.copy(alpha = .4f)
+     o.correct -> OrbitEmerald
+     else -> OrbitCoral
+    }
+    Box(Modifier.weight(1f).fillMaxHeight().clip(RoundedCornerShape(4.dp)).background(fill))
+   }
+  }
+  if (ghost != null && ghostNow != null) {
+   val scale = max(max(ghost.last(), points), 1).toFloat()
+   val me by animateFloatAsState(points / scale, if (motion) tween(400) else snap(), label = "Puntos")
+   val gx by animateFloatAsState(ghostNow / scale, if (motion) tween(400) else snap(), label = "Fantasma")
+   Canvas(Modifier.fillMaxWidth().height(9.dp).semantics { contentDescription = "Llevas $points puntos; tu récord iba por $ghostNow" }) {
+    val y = size.height / 2; val h = 3.dp.toPx()
+    drawRoundRect(colors.surfaceVariant, Offset(0f, y - h / 2), Size(size.width, h), androidx.compose.ui.geometry.CornerRadius(h))
+    drawRoundRect(current.copy(alpha = .75f), Offset(0f, y - h / 2), Size(size.width * me, h), androidx.compose.ui.geometry.CornerRadius(h))
+    drawLine(ChestGold, Offset(size.width * gx, 0f), Offset(size.width * gx, size.height), 2.dp.toPx())
+   }
+  }
+ }
+}
