+private fun DrawScope.drawOrbit(w: OrbitWorld, motion: Boolean, text: DrawScope.(String, Color, Float, Offset, Boolean) -> Unit) {
+ val t = w.task; val s = size.minDimension; val c = center; val r = s * .36f; val nr = s * if (t.nodes >= 10) .066f else .074f
+ val e = w.elapsed()
+ drawRect(Brush.radialGradient(listOf(DeckGlow, Deck), c, s * .75f))
+ val ox = c.x - s / 2; val oy = c.y - s / 2
+ for (st in w.stars) drawCircle(Color(0xFFC8D2FF).copy(alpha = if (motion) .22f + .2f * sin(w.clock / 1250f + st[3]) else .3f), st[2] * density * .7f, Offset(ox + st[0] * s, oy + st[1] * s))
+ drawCircle(NodeRing.copy(alpha = .55f), r, c, style = Stroke(2.dp.toPx()))
+ if (w.phase == OrbitPhase.TURN) drawCircle(OrbitAmber.copy(alpha = .35f * sin(PI.toFloat() * (e.toFloat() / TURN_MS).coerceIn(0f, 1f))), r + nr + 10.dp.toPx(), c, style = Stroke(3.dp.toPx()))
+ // Trail: fades in 600 ms.
+ if (motion) for (i in 0 until w.trailSize) {
+  val idx = (w.trailHead - 1 - i + OrbitWorld.TRAIL) % OrbitWorld.TRAIL
+  val life = 1f - (w.clock - w.trailT[idx]).toFloat() / Orbit.TRAIL_MS; if (life <= 0f) continue
+  val a = w.trailA[idx]
+  drawCircle(OrbitCyan.copy(alpha = .16f * life), (2f + 7f * life) * density, Offset(c.x + cos(a) * r, c.y + sin(a) * r), blendMode = BlendMode.Plus)
+ }
+ for (k in 0 until t.nodes) {
+  val a = w.angle(k); val p = Offset(c.x + cos(a) * r, c.y + sin(a) * r)
+  var light = 0f; var color = OrbitEmerald; var double = false
+  if (w.phase == OrbitPhase.SHOW) { val (l, col, d) = w.light(k, e); light = l; color = col; double = d }
+  val f = 1f - (w.clock - w.flashAt[k]).toFloat() / w.flashDur[k]
+  if (f > light) { light = f; color = w.flashColor[k]; double = false }
+  drawNode(p, nr, light.coerceIn(0f, 1f), color, double, w.phase == OrbitPhase.ANSWER)
+  if (w.input.pending == k && w.phase == OrbitPhase.ANSWER) drawArc(OrbitCyan, -90f, 360f * (1f - (w.clock - w.lastTapAt).toFloat() / Orbit.DOUBLE_WINDOW_MS).coerceIn(0f, 1f), false, Offset(p.x - nr - 7.dp.toPx(), p.y - nr - 7.dp.toPx()), Size((nr + 7.dp.toPx()) * 2, (nr + 7.dp.toPx()) * 2), style = Stroke(2.dp.toPx()))
+  if (w.phase >= OrbitPhase.VERDICT && !w.ok && w.reveal == k) drawCircle(OrbitEmerald.copy(alpha = .6f + .4f * sin(w.clock / 120f)), nr + 7.dp.toPx(), p, style = Stroke(2.5f.dp.toPx(), pathEffect = PathEffect.dashPathEffect(floatArrayOf(5.dp.toPx(), 5.dp.toPx()), if (motion) -w.clock * .02f * density else 0f)))
+ }
+ if (w.phase == OrbitPhase.SHOW) {
+  if (motion) { val a = w.comet(e); if (!a.isNaN()) { val h = Offset(c.x + cos(a) * r, c.y + sin(a) * r); val rr = 18.dp.toPx(); drawCircle(Brush.radialGradient(listOf(Color.White.copy(alpha = .95f), OrbitCyan.copy(alpha = .7f), OrbitCyan.copy(alpha = 0f)), h, rr), rr, h) } }
+  for (d in t.decoys) {
+   val age = e - d.atMs; if (age < 0 || age > DECOY_LIFE_MS) continue
+   val v = sin(PI.toFloat() * age / DECOY_LIFE_MS); val at = Offset(ox + d.x * s, oy + d.y * s); val rr = (6f + 14f * v) * density
+   val path = Path(); for (i in 0 until 8) { val rad = if (i % 2 == 1) rr * .22f else rr; val ang = i * PI.toFloat() / 4 + (if (motion) age / 330f else 0f); if (i == 0) path.moveTo(at.x + cos(ang) * rad, at.y + sin(ang) * rad) else path.lineTo(at.x + cos(ang) * rad, at.y + sin(ang) * rad) }
+   path.close(); drawPath(path, OrbitAmber.copy(alpha = .85f * v), blendMode = BlendMode.Plus)
+  }
+ }
+ val hit = (w.clock - w.decoyHitAt).toFloat() / 400f
+ if (hit in 0f..1f) drawCircle(OrbitCoral.copy(alpha = 1f - hit), (8f + 20f * hit) * density, Offset(ox + w.decoyX * s, oy + w.decoyY * s), style = Stroke(2.dp.toPx()))
+ // Core: the only "Observa" on screen, wrapped in its time ring.
+ val cr = r * .36f; val ring = cr - 6.dp.toPx(); val stroke = 5.dp.toPx()
+ drawCircle(CoreFill, cr, c)
+ drawCircle(Color.White.copy(alpha = .06f), ring, c, style = Stroke(stroke))
+ val box = Offset(c.x - ring, c.y - ring); val boxSize = Size(ring * 2, ring * 2)
+ var label = "OBSERVA"; var sub = ""; var labelColor = OrbitInk
+ when (w.phase) {
+  OrbitPhase.INTRO -> if (t.mode == OrbitMode.MIRROR) sub = "luego, al revés"
+  OrbitPhase.SHOW -> { val frac = (e.toFloat() / t.showMs).coerceIn(0f, 1f); val parts = 48; for (i in 0 until (parts * frac).toInt().coerceAtLeast(1)) drawArc(lerp(OrbitCyan, OrbitAmber, i / parts.toFloat()), -90f + i * 360f / parts, 360f / parts + .6f, false, box, boxSize, style = Stroke(stroke)) }
+  OrbitPhase.TURN -> { label = "GIRA"; labelColor = OrbitAmber; drawArc(OrbitAmber, -90f + (if (motion) e * .3f * sign(t.turn.toFloat()) else 0f), 70f, false, box, boxSize, style = Stroke(stroke, cap = StrokeCap.Round)) }
+  OrbitPhase.ANSWER -> { label = "TU TURNO"; labelColor = OrbitEmerald; sub = "${w.input.index} de ${t.expected.size}"; val left = (1f - e.toFloat() / t.answerMs).coerceIn(0f, 1f); drawArc(if (left < .25f) OrbitCoral else OrbitEmerald, -90f, 360f * left, false, box, boxSize, style = Stroke(stroke, cap = StrokeCap.Round)) }
+  else -> { label = if (w.ok) "BIEN" else "FALLO"; labelColor = if (w.ok) OrbitEmerald else OrbitCoral; sub = if (w.ok) "+${w.points}" + (if (w.focus) " · enfoque" else "") else Orbit.errorText(w.input.error); drawCircle(labelColor, ring, c, style = Stroke(stroke)) }
+ }
+ val fs = max(12.dp.toPx(), cr * .26f)
+ text(label, labelColor, fs, Offset(c.x, c.y - if (sub.isEmpty()) 0f else fs * .4f), true)
+ if (sub.isNotEmpty()) text(sub, OrbitMute, fs * .62f, Offset(c.x, c.y + fs * .72f), false)
+}
+
+private fun DrawScope.drawNode(p: Offset, r: Float, light: Float, color: Color, double: Boolean, armed: Boolean) {
+ if (light > .01f) drawCircle(Brush.radialGradient(listOf(color.copy(alpha = .45f * light), color.copy(alpha = 0f)), p, r * 2.4f), r * 2.4f, p, blendMode = BlendMode.Plus)
+ drawCircle(NodeFill, r, p)
+ drawCircle(if (light > .01f) color.copy(alpha = .35f + .65f * light) else NodeRing.copy(alpha = if (armed) 1f else .75f), r, p, style = Stroke((2f + 1.5f * light) * density))
+ drawCircle(if (light > .01f) color.copy(alpha = .15f + .85f * light) else Color(0xFF060814).copy(alpha = .55f), r * .42f, p)
+ if (double && light > .01f) drawCircle(color.copy(alpha = light), r + 7.dp.toPx(), p, style = Stroke(1.8f * density))
+}
