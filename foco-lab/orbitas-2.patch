+  if (!lastA.isNaN()) {
+   var d = (a - lastA) % (2 * PI).toFloat(); if (d > PI) d -= (2 * PI).toFloat(); if (d < -PI) d += (2 * PI).toFloat()
+   val parts = min(60, ceil(abs(d) / .012f).toInt())
+   for (s in 1 until parts) add(lastA + d * s / parts)
+  }
+  add(a); lastA = a
+ }
+ private fun add(a: Float) { trailA[trailHead] = a; trailT[trailHead] = clock; trailHead = (trailHead + 1) % TRAIL; trailSize = min(TRAIL, trailSize + 1) }
+ /** Light (0..1) of node [k] during the demonstration, its colour and whether it shows the double ring. */
+ fun light(k: Int, e: Long): Triple<Float, Color, Boolean> {
+  var best = 0f; var color = OrbitEmerald; var double = false
+  task.steps.forEachIndexed { i, s ->
+   if (s.node != k) return@forEachIndexed
+   val on = i * task.stepMs + travel
+   val l = if (s.kind == Orbit.DOUBLE) max(bump(e, on, lightDur * 45 / 100), bump(e, on + lightDur * 55 / 100, lightDur * 45 / 100)) else bump(e, on, lightDur)
+   if (l > best) { best = l; color = if (s.kind == Orbit.INVERSE) OrbitMagenta else OrbitEmerald; double = s.kind == Orbit.DOUBLE }
+  }
+  return Triple(best, color, double)
+ }
+ companion object { const val TRAIL = 256 }
+}
+private fun ease(t: Float) = if (t < .5f) 4 * t * t * t else 1 - (-2 * t + 2).pow(3) / 2
+private fun bump(t: Long, start: Long, dur: Long): Float { val u = (t - start).toFloat() / dur; return if (u < 0f || u > 1f) 0f else sin(PI.toFloat() * u) }
+
+/**
+ * Plays one round of Órbitas 2. [done] gets the verdict, the encoded [OrbitLog] and whether the partida stops here
+ * (Órbita expansiva after a miss).
+ */
+@Composable internal fun OrbitBoard(task: OrbitTask, answering: Boolean, done: (Boolean, String, Boolean) -> Unit) {
+ val motion = LocalMotionEnabled.current; val cue = LocalFeedback.current; val note = LocalNote.current
+ val world = remember(task) { OrbitWorld(task) }
+ val report by rememberUpdatedState(done)
+ val measurer = rememberTextMeasurer()
+
+ fun startAnswer() { world.go(OrbitPhase.ANSWER); world.lastTapAt = world.clock }
+ fun succeed() {
+  world.ok = true; world.focus = task.decoys.isNotEmpty() && !world.decoyHit
+  world.points = Orbit.points(task, true, world.focus)
+  // The whole path sounds together as a chord (three voices at most: the sound pool has three streams).
+  task.expected.distinct().sorted().take(3).forEach { note(it, true) }
+  world.go(OrbitPhase.VERDICT)
+ }
+ fun fail(tapped: Int) {
+  world.ok = false; world.reveal = world.input.missed
+  if (tapped >= 0 && tapped != world.reveal) world.flash(tapped, OrbitCoral, 600L)
+  cue(FeedbackCue.RETRY); world.go(OrbitPhase.VERDICT)
+ }
+ fun update() {
+  val e = world.elapsed()
+  when (world.phase) {
+   OrbitPhase.INTRO -> if (e >= INTRO_MS) world.go(OrbitPhase.SHOW)
+   OrbitPhase.SHOW -> {
+    task.steps.forEachIndexed { i, s ->
+     val on = i * task.stepMs + world.travel
+     if (e >= on && !world.fired[2 * i]) { world.fired[2 * i] = true; note(s.node, false) }
+     if (s.kind == Orbit.DOUBLE && e >= on + world.lightDur * 55 / 100 && !world.fired[2 * i + 1]) { world.fired[2 * i + 1] = true; note(s.node, true) }
+    }
+    if (motion) world.pushTrail(world.comet(e))
+    if (e >= task.showMs) { world.pushTrail(Float.NaN); if (task.turn != 0) { world.go(OrbitPhase.TURN); cue(FeedbackCue.WHOOSH) } else startAnswer() }
+   }
+   OrbitPhase.TURN -> {
+    val p = ((e - 200f) / (TURN_MS - 400f)).coerceIn(0f, 1f)
+    world.rot = task.turn * if (motion) ease(p) else if (e >= 200) 1f else 0f
+    if (e >= TURN_MS) { world.rot = task.turn.toFloat(); startAnswer() }
+   }
+   OrbitPhase.ANSWER -> if (world.input.tick(world.clock, world.phaseAt) != null) fail(-1)
+   OrbitPhase.VERDICT -> if (e >= if (world.ok) VERDICT_OK_MS else VERDICT_FAIL_MS) {
+    world.go(OrbitPhase.REPORTED)
+    val missQ = if (world.ok || world.reveal < 0) -1 else Orbit.quadrant(world.reveal, task.nodes, task.turn)
+    val log = OrbitLog(world.ok, task.mode.key, task.stage, task.nodes, task.steps.size, world.input.error, world.focus, world.points, world.times.toList(), missQ)
+    report(world.ok, log.encode(), !world.ok && task.mode == OrbitMode.EXPAND)
+   }
+  }
+ }
+ fun tapNode(best: Int) {
+  if (world.phase != OrbitPhase.ANSWER) return
+    val wasPending = world.input.pending >= 0
+    when (world.input.tap(best, world.clock)) {
+     OrbitTap.HALF -> { world.halfRt = world.clock - world.lastTapAt; world.lastTapAt = world.clock; note(best, false); world.flash(best, OrbitCyan, 300L) }
+     OrbitTap.STEP, OrbitTap.DONE -> {
+      val rt = if (wasPending) world.halfRt else world.clock - world.lastTapAt
+      world.lastTapAt = world.clock
+      world.times += Orbit.quadrant(best, task.nodes, task.turn) to rt
+      note(best, wasPending); world.flash(best, OrbitEmerald); world.step = world.input.index
+      if (world.input.finished) succeed()
+     }
+     OrbitTap.WRONG -> fail(best)
+     OrbitTap.IGNORED -> Unit
+    }
+ }
+
+ fun tap(x: Float, y: Float, w: Float, h: Float) {
+  val s = min(w, h); val cx = w / 2; val cy = h / 2
+  when (world.phase) {
+   OrbitPhase.SHOW -> {
+    val e = world.elapsed()
+    for (d in task.decoys) {
+     val age = e - d.atMs
+     if (age in -50L..DECOY_LIFE_MS + 350L && hypot(x - (cx - s / 2 + d.x * s), y - (cy - s / 2 + d.y * s)) < s * .09f) {
+      world.decoyHit = true; world.decoyHitAt = world.clock; world.decoyX = d.x; world.decoyY = d.y; cue(FeedbackCue.TAP)
+     }
+    }
+   }
+   OrbitPhase.ANSWER -> {
+    val r = s * .36f; val nr = s * if (task.nodes >= 10) .066f else .074f
+    var best = -1; var bd = Float.MAX_VALUE
+    for (k in 0 until task.nodes) { val a = world.angle(k); val d = hypot(x - (cx + cos(a) * r), y - (cy + sin(a) * r)); if (d < bd) { bd = d; best = k } }
+    if (best >= 0 && bd <= nr * 1.45f) tapNode(best)
+   }
+  }
+ }
+ LaunchedEffect(world, answering) {
+  if (!answering) return@LaunchedEffect
+  var last = -1L
+  while (isActive && world.phase != OrbitPhase.REPORTED) {
+   withFrameNanos { t ->
+    world.clock += if (last < 0) 0L else ((t - last) / 1_000_000L).coerceIn(0L, 50L); last = t
+    update(); world.frame = t
+   }
+  }
+ }
+
+ val mirror = task.mode == OrbitMode.MIRROR
+ Column(Modifier.fillMaxWidth(), horizontalAlignment = Alignment.CenterHorizontally, verticalArrangement = Arrangement.spacedBy(6.dp)) {
+  Label("Fase ${task.stage + 1} · ${Orbit.stageNames[task.stage]}" + if (task.mode == OrbitMode.EXPAND) " · ${task.nodes} nodos" else "", MaterialTheme.colorScheme.primary)
+  Text(if (mirror && task.stage == 0) "Recuerda el camino y repítelo al revés" else Orbit.stageTitles[task.stage], style = MaterialTheme.typography.titleLarge, textAlign = TextAlign.Center, modifier = Modifier.fillMaxWidth().heightIn(min = 56.dp).wrapContentHeight(Alignment.CenterVertically))
+ }
+ val description = when (world.phase) {
+  OrbitPhase.INTRO, OrbitPhase.SHOW -> "Órbita de ${task.nodes} nodos. Observa el camino de luz."
+  OrbitPhase.TURN -> "La órbita está girando."
+  OrbitPhase.ANSWER -> "Tu turno: paso ${world.step + 1} de ${task.expected.size}."
+  else -> if (world.ok) "Bien: más ${world.points} puntos." else "Fallo: ${Orbit.errorText(world.input.error)}."
+ }
+ BoxWithConstraints(Modifier.fillMaxWidth().aspectRatio(1f)) {
+ Canvas(Modifier.fillMaxSize().clip(RoundedCornerShape(28.dp)).border(1.dp, DeckEdge, RoundedCornerShape(28.dp))
+  .semantics { contentDescription = description }
+  .pointerInput(world) { awaitEachGesture { val down = awaitFirstDown(requireUnconsumed = false); tap(down.position.x, down.position.y, size.width.toFloat(), size.height.toFloat()) } }) {
+  world.frame // redraw on every frame of the board clock
+  drawOrbit(world, motion) { text, color, px, at, bold ->
+   val layout = measurer.measure(text, TextStyle(color = color, fontSize = px.toSp(), fontWeight = if (bold) FontWeight.Bold else FontWeight.SemiBold, letterSpacing = if (bold) (px * .04f).toSp() else 0f.toSp()))
+   drawText(layout, topLeft = Offset(at.x - layout.size.width / 2f, at.y - layout.size.height / 2f))
+  }
+ }
+ // Screen readers: one invisible target per node, named by its clock position (no numbers on screen, none read aloud).
+ val side = min(maxWidth.value, maxHeight.value).dp; val node = side * (if (task.nodes >= 10) .132f else .148f)
+ val turned = if (world.phase >= OrbitPhase.ANSWER) task.turn else 0
+ for (k in 0 until task.nodes) {
+  val deg = Orbit.angle(k, task.nodes, turned); val a = Math.toRadians(deg - 90.0)
+  Box(Modifier.offset(side / 2 + side * .36f * cos(a).toFloat() - node / 2, side / 2 + side * .36f * sin(a).toFloat() - node / 2).size(node)
+   .semantics { contentDescription = "Nodo a las ${Orbit.clock(deg)}"; role = Role.Button; onClick { tapNode(k); true } })
+ }
+ }
+}
